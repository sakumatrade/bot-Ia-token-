{
  "manifest_version": 3,
  "name": "DominusBot",
  "version": "0.1.0",
  "description": "View DominusBot status, bots, opportunities and research. Read-only: never touches wallets, private keys, or blockchain RPCs.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DominusBot"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"]
}
